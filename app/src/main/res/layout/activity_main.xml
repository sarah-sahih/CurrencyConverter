<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanc">

    <!-- Zone supérieure -->
    <LinearLayout
        android:id="@+id/zoneHaut"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/turquoise"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/clavier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="45">

        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titre"
            android:textColor="@color/blanc"
            android:textSize="20sp"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spDeviseSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/devise_source" />

        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/montant_initial"
            android:textColor="@color/blanc"
            android:textSize="40sp"
            android:gravity="end"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/btnInverser"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="@string/inverser"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/blanc" />

        <Spinner
            android:id="@+id/spDeviseCible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/devise_cible" />

        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/blanc"
            android:textSize="40sp"
            android:gravity="end"
            android:padding="4dp" />

        <Button
            android:id="@+id/btnConvertir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/convertir"
            android:textColor="@color/blanc"
            android:backgroundTint="@color/clavier" />

    </LinearLayout>

    <!-- Clavier numérique : 4 lignes x 3 colonnes -->
    <TableLayout
        android:id="@+id/clavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:stretchColumns="0,1,2"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/zoneHaut"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="55">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_7"
                android:textColor="@color/clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_8"
                android:textColor="@color/clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_9"
                android:textColor="@color/clavier"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_4"
                android:textColor="@color/clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_5"
                android:textColor="@color/clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_6"
                android:textColor="@color/clavier"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_1"
                android:textColor="@color/clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_2"
                android:textColor="@color/clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_3"
                android:textColor="@color/clavier"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnC"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_effacer"
                android:textColor="@color/rouge_clair"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/chiffre_0"
                android:textColor="@color/clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnPoint"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/point_decimal"
                android:textColor="@color/clavier"
                android:textSize="32sp" />
        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
